# Supabase Configuration
# Obtener desde: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Email Configuration
# Para Gmail, generar contraseña de aplicación en: https://myaccount.google.com/apppasswords
EXPO_PUBLIC_EMAIL_USER=your-email@gmail.com
EXPO_PUBLIC_EMAIL_PASS=your-app-password
EXPO_PUBLIC_SUPPORT_EMAIL=support@clinikdent.com

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3001
